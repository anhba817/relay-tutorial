// Reader suggestions (feature 015). One table, anonymous by design — no
// reader identity, contact, IP, or user agent is ever stored (FR-009).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  en
  vi
}

enum SuggestionStatus {
  NEW
  HANDLED
}

model Suggestion {
  id            String           @id @default(cuid())
  pagePath      String
  locale        Locale
  selectedText  String
  contextBefore String
  contextAfter  String
  suggestion    String
  status        SuggestionStatus @default(NEW)
  createdAt     DateTime         @default(now())

  @@index([pagePath, status])
  @@index([createdAt])
}
